Options -Indexes -MultiViews
DirectoryIndex index.php index.html
RewriteEngine On
RewriteBase /

# ── Redirect Legacy URLs (SEO Fixes) ─────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^app\.affscash\.net$ [NC]
RewriteRule ^register$ https://affscash.net/register/affiliate [R=301,L]

RewriteCond %{HTTP_HOST} ^app\.affscash\.net$ [NC]
RewriteRule ^password/reset$ https://affscash.net/forgot-password [R=301,L]

RewriteCond %{HTTP_HOST} ^app\.affscash\.net$ [NC]
RewriteRule ^(.*)$ https://affscash.net/$1 [R=301,L]

RewriteRule ^index\.html$ https://affscash.net/ [R=301,L]

# ── Prevent script execution in uploads ─────────────────────────────────────────
RewriteRule ^(assets/uploads|uploads)/.*\.php$ - [F,L]

# ── Block sensitive directories ───────────────────────────────────────────────
RewriteRule ^config/ - [F,L]
RewriteRule ^core/ - [F,L]
RewriteRule ^models/ - [F,L]
RewriteRule ^controllers/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^storage/ - [F,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^tests/ - [F,L]

# ── Block .git directory and related files ────────────────────────────────────
RewriteRule ^\.git - [F,L]
RewriteRule ^\.gitignore$ - [F,L]
RewriteRule ^\.env.*$ - [F,L]

# ── Block sensitive install files ─────────────────────────────────────────────
RewriteRule ^install/schema\.sql$ - [F,L]
RewriteRule ^install/install\.lock$ - [F,L]
RewriteRule ^install/config_defaults\.json$ - [F,L]

# ── Block dangerous utility scripts (should be deleted, this is defense-in-depth)
RewriteRule ^create_admin\.php$ - [F,L]
RewriteRule ^insert_templates\.php$ - [F,L]
RewriteRule ^test_.*\.php$ - [F,L]
RewriteRule ^check_enum\.php$ - [F,L]

# ── Block Python scripts and dev config files ─────────────────────────────────
RewriteRule \.py$ - [F,L]
RewriteRule ^prepros\.config$ - [F,L]

# ── Block direct access to config JSON (except version.json and sample-offers.json)
RewriteRule ^config\.json$ - [F,L]
RewriteRule ^fraud\.json$ - [F,L]
RewriteRule ^postback\.json$ - [F,L]

# ── Force public route directories through the router ─────────────────────────
RewriteRule ^reviews(/.*)?$ index.php [QSA,L]
RewriteRule ^blog(/.*)?$ index.php [QSA,L]

# ── Skip real files and directories — serve them directly ─────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ── Route everything else through index.php ───────────────────────────────────
RewriteRule ^(.*)$ index.php [QSA,L]

# ── Prevent PHP execution in upload directories ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.php$ - [F,L]
    RewriteRule ^assets/uploads/.*\.php$ - [F,L]
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ── Performance Optimization: Browser Caching & GZIP ───────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Ensure real-time tracking endpoints are NEVER cached ──────────────────────
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/(click|postback|pixel|impression|smartlink|offer|s/|test-postback-click)#">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </If>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
