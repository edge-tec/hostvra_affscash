Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On
RewriteBase /

# Block direct access to sensitive directories and files
RewriteRule ^config/ - [F,L]
RewriteRule ^core/ - [F,L]
RewriteRule ^models/ - [F,L]
RewriteRule ^controllers/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^storage/ - [F,L]
RewriteRule ^data/ - [F,L]
# Block sensitive install files (but allow install/index.php for first-time setup)
RewriteRule ^install/schema\.sql$ - [F,L]
RewriteRule ^install/install\.lock$ - [F,L]
RewriteRule ^install/config_defaults\.json$ - [F,L]

# Force public route directories through the router (physical dirs conflict fix)
RewriteRule ^reviews(/.*)?$ index.php [QSA,L]
RewriteRule ^blog(/.*)?$ index.php [QSA,L]

# Skip real files and directories — serve them directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Security headers — wrapped in IfModule so LiteSpeed won't 403 if mod_headers is unavailable
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
