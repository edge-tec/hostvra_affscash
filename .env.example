# Google reCAPTCHA v3 Configuration
# Site Key: Used on frontend (public)
RECAPTCHA_SITE_KEY=

# Secret Key: Used on backend (private - NEVER expose in frontend, HTML, or logs)
RECAPTCHA_SECRET_KEY=

# Minimum Score Threshold (0.0 to 1.0, default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# Master Enable Switch (set to false in local/dev environment to disable)
RECAPTCHA_ENABLED=true
